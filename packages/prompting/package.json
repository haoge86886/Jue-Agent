{
  "name": "@jue/prompting",
  "version": "0.1.0",
  "description": "Prompt 工程层:静态加载 / 动态构建 / 快照",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@jue/shared-types": "workspace:*",
    "@jue/utils": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
