{
  "id": "text-search-fix",
  "title": "Use text search to locate bug",
  "instruction": "Find the BUG_TOKEN location and replace wrong-total with correct-total.",
  "workspace": "workspace",
  "timeoutMs": 90000,
  "checks": [
    {
      "type": "file_contains",
