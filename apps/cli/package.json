{
    "name":  "@jue/cli",
    "version":  "0.1.0",
    "description":  "Jue Agent CLI 入口",
    "type":  "module",
    "private":  true,
    "main":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js"
                          }
                },
    "scripts":  {
                    "build":  "tsc -p tsconfig.json",
                    "dev":  "tsx src/dev-entry.ts",
                    "start":  "node dist/dev-entry.js",
                    "clean":  "rimraf dist",
                    "typecheck":  "tsc -p tsconfig.json --noEmit"
                },
    "dependencies":  {
                         "@jue/shared-types":  "workspace:*",
                         "@jue/utils":  "workspace:*",
                         "@jue/config":  "workspace:*",
                         "@jue/infra":  "workspace:*",
                         "@jue/runtime":  "workspace:*",
                         "@jue/prompting":  "workspace:*",
                         "@jue/context":  "workspace:*",
                         "@jue/tools":  "workspace:*",
                         "@jue/memory":  "workspace:*",
                         "@jue/subagent":  "workspace:*",
                         "@jue/engine":  "workspace:*",
                         "@jue/session":  "workspace:*",
                         "@jue/audit":  "workspace:*",
                         "commander":  "^14.0.3",
                         "ink":  "^6.4.0",
                         "ink-spinner":  "^5.0.0",
                         "ink-text-input":  "^6.0.0",
                         "react":  "^19.2.6"
                     },
    "devDependencies":  {
                            "@types/react":  "^19.2.14",
                            "tsx":  "4.21.0",
                            "typescript":  "^6.0.3"
                        }
}
