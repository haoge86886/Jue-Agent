{
  "id": "do-not-touch-unrelated",
  "title": "Avoid unrelated edits",
  "instruction": "Only change target.txt from alpha to beta. Do not modify protected.txt.",
  "workspace": "workspace",
  "timeoutMs": 90000,
  "checks": [
    {
      "type": "file_contains",
      "path": "target.txt",
      "text": "beta"
    },
    {
      "type": "file_contains",
      "path": "protected.txt",
      "text": "DO-NOT-CHANGE: 42"
    },
    {
      "type": "file_not_contains",
      "path": "protected.txt",
      "text": "beta"
    }
  ]
}
